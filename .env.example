# ── Plasma network (testnet) ──
PLASMA_RPC=https://testnet-rpc.plasma.to
EXPECTED_CHAIN_ID=9746
PLASMASCAN_API_KEY=

# ── Deployer / demo keys (testnet only — never commit real keys) ──
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
TRUSTED_SIGNER_PRIVATE_KEY=

# ── Settlement asset ──
# Deploy.s.sol reads USDC_ADDR as the single settlement/vault/reserve asset (6-decimal).
# On Plasma testnet there is no public USDT0 (mainnet USDT0 is
# 0xB8CE59FC3717ada4C02eaDF9682A9e934F625ebb, 6-dec). Leave blank to deploy a mock
# 6-decimal ERC-20 (run-plasma-demo.sh handles this), or set a real token address.
USDC_ADDR=

# ── Role addresses (REQUIRED by Deploy.s.sol; for the demo, reuse the deployer) ──
TREASURY_SAFE=
FEE_RECIPIENT=
FIRST_TRUSTED_SIGNER=
EXECUTOR_ADDR=
CREDIT_ADMIN_ADDR=
GUARDIAN_ADDR=
# WARM_REFILL_ADDR=   # optional; omit to skip

# ── Vault metadata ──
VAULT_NAME="Soho USDT Vault"
VAULT_SYMBOL="svUSDT"

# ── Numeric params (optional; Stage-0 defaults applied if unset) ──
# MIN_DELAY, MARK_DEFAULT_DELAY, HOT_FLOAT_CEILING, VAULT_COOLDOWN, VAULT_DEPOSIT_CAP,
# VAULT_INSTANT_ALLOWANCE, TIER2_PERTX, TIER2_DAILY, GLOBAL_DAILY_CAP,
# GLOBAL_OUTSTANDING_CAP, DEPLOY_SALT — see script/DeployConfig.sol
