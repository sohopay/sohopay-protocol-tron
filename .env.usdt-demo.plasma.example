# SOHOPay USDT demo — Plasma Testnet (chain 9746)
# Usage: cp .env.usdt-demo.plasma.example .env.usdt-demo.plasma  (then fill in)
#        ENV_FILE=.env.usdt-demo.plasma ./scripts/tether-demo/deploy-plasma-testnet.sh

# ── network ──
PLASMA_RPC=https://testnet-rpc.plasma.to
EXPECTED_CHAIN_ID=9746
PLASMASCAN_API_KEY=

# ── demo keys (testnet only — throwaway; gas paid in XPL, not ETH) ──
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
TRUSTED_SIGNER_PRIVATE_KEY=

# ── settlement asset (6-decimal) ──
# Phase 1 (default): leave blank → deploy MockUSDTNonStandard (permissionless mint;
#   non-standard no-bool-return token, like real USDT — keeps all 5 acts self-contained).
# Phase 2 (optional): set to testnet USDT0 and pre-fund balances (no mint).
#   Plasma testnet USDT0 (still maturing): 0x246a94a471348881071bb475bf318b7119ab7e2d
# Deploy.s.sol (production path) reads USDC_ADDR; DemoPlasma also accepts USDT_ADDR.
USDT_ADDR=
USDC_ADDR=

# ── role addresses (REQUIRED by the production Deploy.s.sol; reuse the deployer for the demo) ──
TREASURY_SAFE=
FEE_RECIPIENT=
FIRST_TRUSTED_SIGNER=
EXECUTOR_ADDR=
CREDIT_ADMIN_ADDR=
GUARDIAN_ADDR=

# ── vault metadata ──
VAULT_NAME="Soho USDT Vault"
VAULT_SYMBOL="svUSDT"
